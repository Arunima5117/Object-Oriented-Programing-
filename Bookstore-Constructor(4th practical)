#include<iostream>
#include<string>
using namespace std;
class Book
{
 private:
 int bookID;
 string title;
 string author;
 double price;
 public:
 Book()
{
 bookID=101;
 title="C++ programming";
 author="Balguru Swami";
 price=500.00;
}
Book(int id, string t, string a, double p)
{
 bookID=id;
 title=t;
 author=a;
 price=p;
}
void display()
{
 cout<<"Book ID:"<<bookID<<endl;
 cout<<"Title:"<<title<<endl;
 cout<<"Author:"<<author<<endl;
 cout<<"Price:"<<price<<endl;
 cout<<"----------------"<<endl;
}
};
int main()
{
 Book book1;
 Book book2(102,"Object Oriented Programming","Robert Lafore",690.00);
 cout<<"First Book Details:"<<endl;
 book1.display();
 cout<<"Second Book Details:"<<endl;
 book2.display();
 return 0;
}
